---
import HeadMeta from '../seo/HeadMeta.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import '../../styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogType?: string;
  ogImage?: string;
  lang?: string;
  jsonLd?: any | any[];
}

const { title, description, canonicalUrl, ogType, ogImage, lang = 'zh-CN', jsonLd } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
  <HeadMeta title={title} description={description} canonicalUrl={canonicalUrl} ogType={ogType} ogImage={ogImage} lang={lang} jsonLd={jsonLd} />
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
