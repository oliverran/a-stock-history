---
import BaseLayout from '../components/layout/BaseLayout.astro';
import PageHero from '../components/layout/PageHero.astro';
import SectionBlock from '../components/layout/SectionBlock.astro';
import CardGrid from '../components/layout/CardGrid.astro';
import Card from '../components/layout/Card.astro';
---

<BaseLayout
  title="Market Chronicle | A股编年史 & U.S. Market Chronicle"
  description="双市场金融编年史：/cn/ 中国 A 股，/us/ 美国股票市场。每个专题可引用、可复核、可追溯到 API。"
  lang="zh-CN"
>
  <PageHero 
    title="Market Chronicle"
    description="把市场写成编年体，而不是导航页：每张图回答一个明确问题，每个 panel 有独立 URL 与 API。"
    lastUpdated={new Date().toISOString().split('T')[0]}
  />

  <SectionBlock 
    sectionNumber="I"
    title="China A-Shares / CN"
    description="中国 A 股编年史：宽基、行业、抱团三条主线。"
  >
    <CardGrid>
      <Card href="/cn/" title="进入 /cn/ →" description="A 股线入口与总览。" />
      <Card href="/cn/broad" title="宽基 / Broad" description="长期形状、年度回报、回撤名册、估值锚点与结构迁移。" />
      <Card href="/cn/sectors" title="行业 / Sectors" description="轮动总图、行业估值对比与每个行业的独立专题页。" />
      <Card href="/cn/clusters" title="抱团 / Clusters" description="集中度、相关性、谱系与典型抱团组合的历史样本。" />
    </CardGrid>
  </SectionBlock>

  <hr class="divider container" />

  <SectionBlock 
    sectionNumber="II"
    title="U.S. Market / US"
    description="美国市场编年史：世纪尺度、估值周期、回撤名册与集中度。"
  >
    <CardGrid>
      <Card href="/us/" title="Enter /us/ →" description="U.S. 线入口与总览。" />
      <Card href="/us/sp500" title="S&P 500" description="Century scale, annual outcomes, drawdowns, valuation anchors." />
      <Card href="/us/nasdaq" title="Nasdaq" description="Composite lens, drawdowns, valuation, concentration." />
      <Card href="/us/mag7" title="Mag7" description="Concentration, contribution and crowding proxies." />
    </CardGrid>
  </SectionBlock>

</BaseLayout>
