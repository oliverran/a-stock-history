---
import BaseLayout from '../components/layout/BaseLayout.astro';
import PageHero from '../components/layout/PageHero.astro';
import SectionBlock from '../components/layout/SectionBlock.astro';
import CardGrid from '../components/layout/CardGrid.astro';
import Card from '../components/layout/Card.astro';
---

<BaseLayout 
  title="A股编年史 · The Chronicle of China A-Shares" 
  description="一份关于中国 A 股市场的长周期编年体档案。记录市场的长期形状、行业轮动与抱团叙事。"
>
  <PageHero 
    title="A股编年史" 
    description="一份关于中国 A 股市场的长周期编年体档案。用宽基指数记录市场的长期形状，用行业指数记录轮动与风格迁移，用抱团叙事记录不同阶段的共识资产如何形成、扩张和退潮。"
    lastUpdated={new Date().toISOString().split('T')[0]}
  />

  <SectionBlock 
    sectionNumber="I" 
    title="The Market / 宽基与时代" 
    description="市场是一个复杂的非线性系统，但拉长周期，依然能看到清晰的估值钟摆与时代分幕。本章通过各大宽基指数及历史回撤数据，刻画 A 股的总体形貌。"
  >
    <CardGrid>
      <Card href="/broad/shanghai-composite" title="上证综指" description="A 股市场的起点与最广泛的代表。" />
      <Card href="/broad/hs300" title="沪深 300" description="核心资产的压舱石，反映大盘蓝筹的兴衰。" />
      <Card href="/broad/eras" title="六时代" description="从草莽时代到机构化时代，市场的阶段性特征。" />
      <Card href="/broad/drawdown" title="回撤名册" description="历次大级别熊市的深度与修复周期考证。" />
      <Card href="/broad/" title="Explore Broad →" description="查看全部 12 张宽基图表" />
    </CardGrid>
  </SectionBlock>

  <hr class="divider container" />

  <SectionBlock 
    sectionNumber="II" 
    title="The Sectors / 行业与轮动" 
    description="存量博弈下，资金在不同产业间如同潮汐般涌动。本章追踪白酒、新能源、半导体等七大核心赛道的周期起伏。"
  >
    <CardGrid>
      <Card href="/sectors/baijiu" title="白酒" description="从周期品到消费品的估值重塑。" />
      <Card href="/sectors/new-energy" title="新能源" description="碳中和叙事下的超级贝塔与产能出清。" />
      <Card href="/sectors/rotation" title="轮动总图" description="板块间跷跷板效应与资金迁移轨迹。" />
      <Card href="/sectors/" title="Explore Sectors →" description="查看全部 9 张行业图表" />
    </CardGrid>
  </SectionBlock>

  <hr class="divider container" />

  <SectionBlock 
    sectionNumber="III" 
    title="The Clusters / 抱团与共识" 
    description="每一次大牛市的背后，都有一套逻辑自洽的宏大叙事。本章记录历代抱团资产的聚变与裂变。"
  >
    <CardGrid>
      <Card href="/clusters/liquor-club" title="茅指数" description="核心资产与外资定价权时代的象征。" />
      <Card href="/clusters/ning-combo" title="宁组合" description="高景气度与 PEG 估值法的极致演绎。" />
      <Card href="/clusters/special-valuation" title="中特估" description="低估值、高股息与国家意志的结合。" />
      <Card href="/clusters/ai-compute" title="AI 算力" description="通用人工智能时代的算力基建叙事。" />
      <Card href="/clusters/" title="Explore Clusters →" description="查看全部 8 张抱团图表" />
    </CardGrid>
  </SectionBlock>

</BaseLayout>
