---
import HubPage from '../../../layouts/HubPage.astro';
import { cnClustersHub } from '../../../content/cn/clusters';
import { getLastModifiedForPrefix, loadApiManifest } from '../../../lib/api/manifest';

const manifest = await loadApiManifest().catch(() => null);
const lastUpdated = manifest ? getLastModifiedForPrefix(manifest, '/api/cn/clusters') : undefined;

const sections = cnClustersHub.sections.map((s) => ({
  sectionNumber: s.sectionNumber,
  title: s.title,
  description: s.description,
  panels: s.panelKeys.map((k) => {
    const p = cnClustersHub.panels[k];
    return {
      href: `/cn/clusters/${p.key}`,
      title: p.title,
      description: p.description,
    };
  }),
}));
---

<HubPage
  title={cnClustersHub.title}
  description={cnClustersHub.description}
  heroTitle={cnClustersHub.heroTitle}
  heroDescription={cnClustersHub.heroDescription}
  sections={sections}
  related={cnClustersHub.related}
  lastUpdated={lastUpdated}
  lang={cnClustersHub.lang}
/>

