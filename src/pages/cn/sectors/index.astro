---
import HubPage from '../../../layouts/HubPage.astro';
import { cnSectorsHub } from '../../../content/cn/sectors';
import { getLastModifiedForPrefix, loadApiManifest } from '../../../lib/api/manifest';

const manifest = await loadApiManifest().catch(() => null);
const lastUpdated = manifest ? getLastModifiedForPrefix(manifest, '/api/cn/sectors') : undefined;

const sections = cnSectorsHub.sections.map((s) => ({
  sectionNumber: s.sectionNumber,
  title: s.title,
  description: s.description,
  panels: s.panelKeys.map((k) => {
    const p = cnSectorsHub.panels[k];
    return {
      href: `/cn/sectors/${p.key}`,
      title: p.title,
      description: p.description,
    };
  }),
}));
---

<HubPage
  title={cnSectorsHub.title}
  description={cnSectorsHub.description}
  heroTitle={cnSectorsHub.heroTitle}
  heroDescription={cnSectorsHub.heroDescription}
  sections={sections}
  related={cnSectorsHub.related}
  lastUpdated={lastUpdated}
  lang={cnSectorsHub.lang}
/>

