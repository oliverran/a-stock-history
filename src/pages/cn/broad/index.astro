---
import HubPage from '../../../layouts/HubPage.astro';
import { cnBroadHub } from '../../../content/cn/broad';
import { getLastModifiedForPrefix, loadApiManifest } from '../../../lib/api/manifest';

const manifest = await loadApiManifest().catch(() => null);
const lastUpdated = manifest ? getLastModifiedForPrefix(manifest, '/api/cn/broad') : undefined;

const sections = cnBroadHub.sections.map((s) => ({
  sectionNumber: s.sectionNumber,
  title: s.title,
  description: s.description,
  panels: s.panelKeys.map((k) => {
    const p = cnBroadHub.panels[k];
    return {
      href: `/cn/broad/${p.key}`,
      title: p.title,
      description: p.description,
    };
  }),
}));
---

<HubPage
  title={cnBroadHub.title}
  description={cnBroadHub.description}
  heroTitle={cnBroadHub.heroTitle}
  heroDescription={cnBroadHub.heroDescription}
  sections={sections}
  related={cnBroadHub.related}
  lastUpdated={lastUpdated}
  lang={cnBroadHub.lang}
/>

