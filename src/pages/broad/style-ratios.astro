---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import PageHero from '../../components/layout/PageHero.astro';
import ChartBox from '../../components/charts/ChartBox.astro';
import SectionBlock from '../../components/layout/SectionBlock.astro';
---

<BaseLayout 
  title="风格比值 | A股编年史" 
  description="大盘 vs 小盘，价值 vs 成长的周期往复。"
>
  <PageHero 
    title="风格比值" 
    description="没有永远占优的风格。当大盘蓝筹的确定性溢价被透支，资金便会去小盘股里寻找弹性；当成长股的景气度证伪，红利价值便会成为避风港。"
    lastUpdated={new Date().toISOString().split('T')[0]}
  />

  <div class="container">
    <ChartBox 
      id="style-ratios" 
      apiEndpoint="/api/broad/style-ratios.json"
      title="沪深300 / 中证1000 相对强弱"
      description="向上代表大盘占优，向下代表小盘占优。"
    />
  </div>
</BaseLayout>
