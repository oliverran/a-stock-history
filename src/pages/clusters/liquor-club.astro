---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import PageHero from '../../components/layout/PageHero.astro';
import ChartBox from '../../components/charts/ChartBox.astro';
import SectionBlock from '../../components/layout/SectionBlock.astro';
---

<BaseLayout 
  title="茅指数 | A股编年史" 
  description="核心资产与外资定价权时代的象征。"
>
  <PageHero 
    title="茅指数 (The Liquor Club)" 
    description="在沪港通开通与供给侧改革的交响乐中，外资带着低利率时代的 DCF 模型杀入 A 股。以贵州茅台为首的核心资产，迎来了史诗级的估值重塑。"
    lastUpdated={new Date().toISOString().split('T')[0]}
  />

  <div class="container">
    <ChartBox 
      id="liquor-club" 
      apiEndpoint="/api/clusters/liquor-club.json"
      title="茅指数相对沪深300超额收益"
      description="2016-2021：长坡厚雪的黄金时代。"
    />
    
    <SectionBlock sectionNumber="1" title="抱团逻辑 (The Consensus)">
      <ul class="text-editorial">
        <li><strong>宏观背景：</strong> 经济增速换挡，总量贝塔消失，资金开始追逐确定性。</li>
        <li><strong>微观基础：</strong> 供给侧改革导致行业集中度提升，龙头企业展现出强大的抗风险能力。</li>
        <li><strong>增量资金：</strong> 北向资金持续净流入，彻底重塑了 A 股“炒小、炒新、炒差”的审美。</li>
      </ul>
    </SectionBlock>
  </div>
</BaseLayout>
