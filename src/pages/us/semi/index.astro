---
import HubPage from '../../../layouts/HubPage.astro';
import { usSemiHub } from '../../../content/us/semi';
import { getLastModifiedForPrefix, loadApiManifest } from '../../../lib/api/manifest';

const manifest = await loadApiManifest().catch(() => null);
const lastUpdated = manifest ? getLastModifiedForPrefix(manifest, '/api/us/semi') : undefined;

const sections = usSemiHub.sections.map((s) => ({
  sectionNumber: s.sectionNumber,
  title: s.title,
  description: s.description,
  panels: s.panelKeys.map((k) => {
    const p = usSemiHub.panels[k];
    return {
      href: `/us/semi/${p.key}`,
      title: p.title,
      description: p.description,
    };
  }),
}));
---

<HubPage
  title={usSemiHub.title}
  description={usSemiHub.description}
  heroTitle={usSemiHub.heroTitle}
  heroDescription={usSemiHub.heroDescription}
  sections={sections}
  related={usSemiHub.related}
  lastUpdated={lastUpdated}
  lang={usSemiHub.lang}
/>

