---
import HubPage from '../../../layouts/HubPage.astro';
import { usMag7Hub } from '../../../content/us/mag7';
import { getLastModifiedForPrefix, loadApiManifest } from '../../../lib/api/manifest';

const manifest = await loadApiManifest().catch(() => null);
const lastUpdated = manifest ? getLastModifiedForPrefix(manifest, '/api/us/mag7') : undefined;

const sections = usMag7Hub.sections.map((s) => ({
  sectionNumber: s.sectionNumber,
  title: s.title,
  description: s.description,
  panels: s.panelKeys.map((k) => {
    const p = usMag7Hub.panels[k];
    return {
      href: `/us/mag7/${p.key}`,
      title: p.title,
      description: p.description,
    };
  }),
}));
---

<HubPage
  title={usMag7Hub.title}
  description={usMag7Hub.description}
  heroTitle={usMag7Hub.heroTitle}
  heroDescription={usMag7Hub.heroDescription}
  sections={sections}
  related={usMag7Hub.related}
  lastUpdated={lastUpdated}
  lang={usMag7Hub.lang}
/>

