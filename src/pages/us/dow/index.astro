---
import HubPage from '../../../layouts/HubPage.astro';
import { usDowHub } from '../../../content/us/dow';
import { getLastModifiedForPrefix, loadApiManifest } from '../../../lib/api/manifest';

const manifest = await loadApiManifest().catch(() => null);
const lastUpdated = manifest ? getLastModifiedForPrefix(manifest, '/api/us/dow') : undefined;

const sections = usDowHub.sections.map((s) => ({
  sectionNumber: s.sectionNumber,
  title: s.title,
  description: s.description,
  panels: s.panelKeys.map((k) => {
    const p = usDowHub.panels[k];
    return {
      href: `/us/dow/${p.key}`,
      title: p.title,
      description: p.description,
    };
  }),
}));
---

<HubPage
  title={usDowHub.title}
  description={usDowHub.description}
  heroTitle={usDowHub.heroTitle}
  heroDescription={usDowHub.heroDescription}
  sections={sections}
  related={usDowHub.related}
  lastUpdated={lastUpdated}
  lang={usDowHub.lang}
/>

