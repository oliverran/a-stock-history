---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import PageHero from '../../components/layout/PageHero.astro';
import ChartBox from '../../components/charts/ChartBox.astro';
import SectionBlock from '../../components/layout/SectionBlock.astro';
---

<BaseLayout 
  title="白酒 | A股编年史" 
  description="长坡厚雪，量价齐升的消费图腾。"
>
  <PageHero 
    title="白酒 (Liquor)" 
    description="从周期品到消费品，再到社交货币与金融资产。白酒板块的估值重塑，是过去十年 A 股最宏大的一场关于确定性的叙事。"
    lastUpdated={new Date().toISOString().split('T')[0]}
  />

  <div class="container">
    <ChartBox 
      id="baijiu" 
      apiEndpoint="/api/sectors/baijiu.json"
      title="中证白酒超额收益走势"
      description="相对沪深300的超额收益，记录了提价周期与外资流入的共振。"
    />
    
    <SectionBlock sectionNumber="1" title="产业逻辑 (Industry Logic)">
      <ul class="text-editorial">
        <li><strong>量价齐升：</strong> 伴随城镇化与消费升级，白酒完成了从“政务消费”向“商务/大众消费”的惊险一跃。</li>
        <li><strong>定价权：</strong> 极高的毛利率、不需要持续资本开支、越存越香的存货属性，赋予了高端白酒无可匹敌的提价权。</li>
        <li><strong>外资重估：</strong> 沪港通开通后，外资基于 DCF 模型对白酒稳定现金流进行了系统性的拔估值。</li>
      </ul>
    </SectionBlock>
  </div>
</BaseLayout>
