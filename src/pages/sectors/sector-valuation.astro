---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import PageHero from '../../components/layout/PageHero.astro';
import ChartBox from '../../components/charts/ChartBox.astro';
import SectionBlock from '../../components/layout/SectionBlock.astro';
---

<BaseLayout 
  title="行业估值对比 | A股编年史" 
  description="各大行业当前 PE 所处历史分位数对比。"
>
  <PageHero 
    title="行业估值 (Sector Valuation)" 
    description="买的好不如买的便宜。跨行业比较不仅需要看绝对景气度，还需要看当前价格是否已经透支了未来的预期。"
    lastUpdated={new Date().toISOString().split('T')[0]}
  />

  <div class="container">
    <ChartBox 
      id="sector-valuation" 
      apiEndpoint="/api/sectors/sector-valuation.json"
      title="核心行业当前 PE 历史分位数"
      description="数值越低，代表相对其自身历史估值水平越便宜。"
    />
  </div>
</BaseLayout>
