---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import PageHero from '../../components/layout/PageHero.astro';
import SectionBlock from '../../components/layout/SectionBlock.astro';
import fs from 'fs';
import path from 'path';

// 我们可以动态读取 public/api/_manifest.json 来展示
let manifestData = null;
try {
  const manifestPath = path.resolve(process.cwd(), 'public/api/_manifest.json');
  const raw = fs.readFileSync(manifestPath, 'utf-8');
  manifestData = JSON.parse(raw);
} catch (e) {
  console.error("Could not load API manifest");
}
---

<BaseLayout 
  title="API 开放数据 | A股编年史" 
  description="A股编年史底层静态 JSON 数据接口说明。"
>
  <PageHero 
    title="Open API" 
    description="本站秉持「数据民主化」理念。所有的图表底层数据均以纯静态 JSON 格式对外暴露，无需鉴权，支持跨域读取与自由引用。"
  />

  <div class="container">
    <SectionBlock sectionNumber="1" title="API 架构 (Architecture)">
      <p class="text-editorial">
        本站 API 并非由动态后端服务提供，而是通过构建脚本预先生成的<strong>纯静态文件</strong>，托管在边缘 CDN 上。这意味着极高的响应速度与永不宕机的稳定性。
      </p>
      
      {manifestData && (
        <div class="api-card">
          <h4>全局 Manifest</h4>
          <p class="text-caption">Endpoint: <code>/api/_manifest.json</code></p>
          <pre><code>{JSON.stringify(manifestData, null, 2)}</code></pre>
        </div>
      )}
    </SectionBlock>

    <SectionBlock sectionNumber="2" title="数据结构 (Data Schema)">
      <p class="text-editorial">
        每个终端 JSON 文件都遵循统一的响应规范，包含 <code>meta</code> 元数据对象与 <code>series</code> 时序数组。
      </p>
      <div class="api-card">
        <pre><code>{`{
  "meta": {
    "id": "shanghai-composite",
    "name": "上证综指",
    "type": "line",
    "description": "上海证券交易所综合股价指数"
  },
  "series": [
    {
      "date": "1990-12-19",
      "value": 100.00
    },
    // ...
  ]
}`}</code></pre>
      </div>
    </SectionBlock>

    <SectionBlock sectionNumber="3" title="使用限制 (Usage Limits)">
      <p class="text-editorial">
        由于是静态托管，我们没有设置严格的 Rate Limit（速率限制）。但请在合理范围内调用，并在用于二次发布或学术论文时注明出处：<br>
        <em>"数据引用自 A股编年史 (The Chronicle of China A-Shares)"</em>。
      </p>
    </SectionBlock>
  </div>
</BaseLayout>

<style>
  .api-card {
    background-color: rgba(255, 255, 255, 0.5);
    border: 1px solid var(--color-line);
    padding: var(--spacing-md);
    margin-top: var(--spacing-sm);
  }
  .api-card h4 {
    margin-top: 0;
    font-family: var(--font-mono);
  }
  pre {
    background-color: var(--color-ink);
    color: var(--color-paper);
    padding: var(--spacing-sm);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.4;
  }
</style>
