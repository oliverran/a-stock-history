---
import BaseLayout from '../components/layout/BaseLayout.astro';
import PageHero from '../components/layout/PageHero.astro';
import SectionBlock from '../components/layout/SectionBlock.astro';
import ChartBox from '../components/charts/ChartBox.astro';

export interface Props {
  title: string;
  description: string;
  lead?: string;
  judgement?: string;
  apiEndpoint: string;
  chartId: string;
  chartTitle: string;
  chartDescription?: string;
  chartHeight?: string;
  howToRead?: string;
  keyFindings?: string[];
  methodology?: string;
  sources?: string[];
  relatedLinks?: Array<{ href: string; title: string; description?: string }>;
  relatedPanels?: Array<{ href: string; title: string }>;
  lastUpdated?: string;
  lang?: string;
  jsonLd?: any | any[];
  apiData?: any;
}

const {
  title,
  description,
  lead,
  judgement,
  apiEndpoint,
  chartId,
  chartTitle,
  chartDescription,
  chartHeight,
  howToRead,
  keyFindings,
  methodology,
  sources,
  relatedLinks,
  relatedPanels,
  lastUpdated,
  lang = 'zh-CN',
  jsonLd,
  apiData,
} = Astro.props;
---

<BaseLayout title={title} description={description} lang={lang} jsonLd={jsonLd} ogType="article">
  <PageHero title={title} description={lead ?? description} lastUpdated={lastUpdated} />

  <div class="container">
    <ChartBox
      id={chartId}
      apiEndpoint={apiEndpoint}
      title={chartTitle}
      description={chartDescription}
      height={chartHeight}
      lang={lang}
    />

    {(judgement ||
      howToRead ||
      (keyFindings && keyFindings.length > 0) ||
      methodology ||
      (sources && sources.length > 0) ||
      (relatedLinks && relatedLinks.length > 0)) && (
      <div class="panel-notes">
        {judgement && (
          <SectionBlock sectionNumber="0" title={lang === 'zh-CN' ? '判断' : 'Takeaway'}>
            <p class="text-editorial">{judgement}</p>
          </SectionBlock>
        )}

        {howToRead && (
          <SectionBlock sectionNumber="1" title={lang === 'zh-CN' ? '读图方法' : 'How to Read'}>
            <p class="text-editorial">{howToRead}</p>
          </SectionBlock>
        )}

        {keyFindings && keyFindings.length > 0 && (
          <SectionBlock sectionNumber="2" title={lang === 'zh-CN' ? '关键发现' : 'Key Findings'}>
            <ul class="text-editorial">
              {keyFindings.map((it) => (
                <li>{it}</li>
              ))}
            </ul>
          </SectionBlock>
        )}

        {(methodology || (sources && sources.length > 0)) && (
          <SectionBlock sectionNumber="3" title={lang === 'zh-CN' ? '方法与来源' : 'Methodology & Sources'}>
            {methodology && <p class="text-editorial">{methodology}</p>}
            {sources && sources.length > 0 && (
              <ul class="text-editorial">
                {sources.map((it) => (
                  <li>{it}</li>
                ))}
              </ul>
            )}
          </SectionBlock>
        )}

        {relatedLinks && relatedLinks.length > 0 && (
          <SectionBlock sectionNumber="4" title={lang === 'zh-CN' ? '相关链接' : 'Links'}>
            <ul class="text-editorial">
              {relatedLinks.map((it) => (
                <li>
                  <a href={it.href} target="_blank">{it.title}</a>
                  {it.description ? ` — ${it.description}` : ''}
                </li>
              ))}
            </ul>
          </SectionBlock>
        )}

        {apiData?.events && Array.isArray(apiData.events) && apiData.events.length > 0 && (
          <SectionBlock sectionNumber="5" title={lang === 'zh-CN' ? '回撤事件目录' : 'Drawdown Events'}>
            <div class="events-table">
              <div class="events-row events-head">
                <div>事件</div>
                <div>开始</div>
                <div>最低</div>
                <div>修复</div>
                <div>深度</div>
                <div>下跌天数</div>
                <div>修复天数</div>
              </div>
              {apiData.events.map((ev: any, idx: number) => (
                <div class="events-row" data-idx={idx}>
                  <div>{ev.name ?? `事件#${idx + 1}`}</div>
                  <div>{ev.start}</div>
                  <div>{ev.trough}</div>
                  <div>{ev.end}</div>
                  <div>{typeof ev.depth === 'number' ? `${ev.depth.toFixed(2)}%` : ev.depth}</div>
                  <div>{ev.durationDays}</div>
                  <div>{ev.recoveryDays}</div>
                </div>
              ))}
            </div>
          </SectionBlock>
        )}
      </div>
    )}

    <SectionBlock sectionNumber="A" title={lang === 'zh-CN' ? 'API 数据' : 'API'}>
      <p class="text-editorial">
        <a href={apiEndpoint} target="_blank">{lang === 'zh-CN' ? '下载 JSON' : 'Download JSON'}</a>
      </p>
    </SectionBlock>

    {relatedPanels && relatedPanels.length > 0 && (
      <SectionBlock sectionNumber="R" title={lang === 'zh-CN' ? '相关图表' : 'Related'}>
        <ul class="text-editorial">
          {relatedPanels.map((p) => (
            <li><a href={p.href}>{p.title}</a></li>
          ))}
        </ul>
      </SectionBlock>
    )}
  </div>
</BaseLayout>

<style>
  .events-table {
    border: 1px solid var(--color-border, rgba(0,0,0,0.12));
    border-radius: 8px;
    overflow: hidden;
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace);
    font-size: 0.9rem;
  }
  .events-row {
    display: grid;
    grid-template-columns: 1.4fr 0.9fr 0.9fr 0.9fr 0.7fr 0.7fr 0.7fr;
    gap: 10px;
    padding: 10px 12px;
    border-top: 1px solid var(--color-border, rgba(0,0,0,0.08));
  }
  .events-row:first-child {
    border-top: 0;
  }
  .events-head {
    background: rgba(0,0,0,0.03);
    font-weight: 600;
  }
  .events-row > div {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>

